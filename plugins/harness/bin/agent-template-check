#!/usr/bin/env python3
"""Read-only comparison of a project's `.claude/memory/` against the bundled template reference.

Why this exists (issue #132):
  The plugin updates itself, but the opinion pack is copied into a project **once**. A project
  that adopted the pack early never receives data files added later — `reflect-skip.json`
  (the data half of #130) is the case that matters — and nothing tells it so. The build now
  ships a copy of `project-template/.claude/memory/` next to this script as a comparison
  reference. The rest of `project-template/` (AGENTS.md, CLAUDE.md, .github/) is not shipped:
  those are the project's own rules and are expected to differ.

What it can and cannot say:
  There is no record of which template version a project copied, so a file that differs may be
  a deliberate customization or an older copy — this script cannot tell them apart and never
  claims either. It reports four statuses per reference file:

    missing    no file at the corresponding project path
    differs    the file exists and its content differs (CRLF and LF line endings are treated
               as equal)
    identical  same content, with the same line-ending normalization
    skipped    not compared; the reason is given (the comparison is then incomplete)

  Only paths and statuses are printed. Project file content is never shown.

Engine vs data:
  This script knows nothing about which files the reference holds — it walks whatever
  reference tree it is given. The file list is data, copied from `project-template/` by build.sh.

Exit codes: 0 = the comparison ran (whatever it found), 1 = it could not run (invalid project
or reference), 2 = command-line usage error (argparse).

It never writes: no project file, no cache, no log.
"""
import argparse
import errno
import json
import os
import stat
import sys

MEMORY_DIR = (".claude", "memory")
REFERENCE_DIRNAME = "template-reference"

# Stable machine-readable reasons for `skipped`; the text report uses the phrases.
REASONS = {
    "link_outside_project": "a link on this path resolves outside the project",
    "broken_link": "a link on this path points at nothing",
    "link_loop": "a link on this path loops",
    "not_a_directory": "a parent path is not a directory",
    "not_a_regular_file": "not a regular file",
    "unreadable": "could not be read",
}


class ReferenceInvalid(Exception):
    """The reference tree is unusable — reporting "all good" from it would be a lie."""


def default_reference():
    # Co-location convention: build.sh places the reference next to this script.
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), REFERENCE_DIRNAME)


def reference_files(ref_dir):
    """Every regular file under the reference, as sorted relative POSIX paths.

    The reference is generated by build.sh with plain copies, so a link, a special file or an
    empty tree means it is broken — fail rather than compare against a partial reference.
    """
    if not os.path.isdir(ref_dir):
        raise ReferenceInvalid(f"reference directory not found: {ref_dir}")

    def fail(err):  # os.walk skips unreadable directories silently by default
        raise ReferenceInvalid(f"reference could not be read: {err}")

    files = []
    try:
        for dirpath, dirnames, filenames in os.walk(ref_dir, onerror=fail):
            for name in dirnames + filenames:
                path = os.path.join(dirpath, name)
                mode = os.lstat(path).st_mode
                if stat.S_ISLNK(mode):
                    raise ReferenceInvalid(f"reference contains a link: {path}")
                if name in filenames:
                    if not stat.S_ISREG(mode):
                        raise ReferenceInvalid(f"reference contains a non-regular file: {path}")
                    files.append(os.path.relpath(path, ref_dir).replace(os.sep, "/"))
    except OSError as e:
        raise ReferenceInvalid(f"reference could not be read: {e}") from e
    if not files:
        raise ReferenceInvalid(f"reference directory is empty: {ref_dir}")
    return sorted(files)


def _inside(path, root):
    try:
        return path == root or os.path.commonpath([path, root]) == root
    except ValueError:  # no common root, e.g. different Windows drives
        return False


def resolve_in_project(root, parts):
    """Walk `parts` from `root` one component at a time without leaving the project.

    Returns ("ok", real_path), ("missing", None) or ("skipped", reason). Links are followed only
    while they resolve inside the project, so a shared `.claude/memory` linked from elsewhere in
    the repository compares normally, while a file behind a link that escapes the project — even
    one that does not exist — is skipped rather than reported as missing.
    """
    cur = root
    last = len(parts) - 1
    for i, part in enumerate(parts):
        nxt = os.path.join(cur, part)
        try:
            mode = os.lstat(nxt).st_mode
        except FileNotFoundError:
            return "missing", None
        except NotADirectoryError:
            return "skipped", "not_a_directory"
        except OSError:
            return "skipped", "unreadable"
        if stat.S_ISLNK(mode):
            # Non-strict realpath (strict= needs Python 3.10); os.stat then classifies the target.
            real = os.path.realpath(nxt)
            if not _inside(real, root):
                return "skipped", "link_outside_project"
            try:
                mode = os.stat(real).st_mode
            except FileNotFoundError:
                return "skipped", "broken_link"
            except OSError as e:
                if e.errno == errno.ELOOP:
                    return "skipped", "link_loop"
                if e.errno == errno.ENOTDIR:
                    return "skipped", "not_a_directory"
                return "skipped", "unreadable"
            nxt = real
        if i < last and not stat.S_ISDIR(mode):
            return "skipped", "not_a_directory"
        if i == last and not stat.S_ISREG(mode):
            # Checked before opening: reading a FIFO would block forever.
            return "skipped", "not_a_regular_file"
        cur = nxt
    return "ok", cur


def _normalized(path):
    with open(path, "rb") as f:
        return f.read().replace(b"\r\n", b"\n")


def compare(project_dir, ref_dir):
    root = os.path.realpath(project_dir)
    results = []
    for rel in reference_files(ref_dir):
        parts = list(MEMORY_DIR) + rel.split("/")
        entry = {"path": "/".join(parts), "reference": os.path.join(ref_dir, *rel.split("/"))}
        state, value = resolve_in_project(root, parts)
        if state == "ok":
            try:
                same = _normalized(value) == _normalized(entry["reference"])
                entry["status"] = "identical" if same else "differs"
            except OSError:
                entry["status"], entry["reason"] = "skipped", "unreadable"
        elif state == "missing":
            entry["status"] = "missing"
        else:
            entry["status"], entry["reason"] = "skipped", value
        results.append(entry)
    return results


def _counts(results):
    counts = {k: 0 for k in ("missing", "differs", "identical", "skipped")}
    for r in results:
        counts[r["status"]] += 1
    return counts


def render_text(project_dir, ref_dir, results, verbose=False):
    counts = _counts(results)

    def by(status):
        return [r for r in results if r["status"] == status]

    out = [
        "Template check (read-only)",
        f"Project:   {project_dir}",
        f"Reference: {ref_dir}",
        f"Compared {len(results)} reference files against the project's .claude/memory/.",
        "Reference copy of a listed file: the reference directory joined with the path after",
        "the leading .claude/memory/.",
        "",
    ]
    if counts["missing"]:
        out.append(f"Missing from the project ({counts['missing']}):")
        for r in by("missing"):
            out.append(f"  {r['path']}")
        out.append("  Review each reference copy and decide whether this project needs it. Some are")
        out.append("  optional examples, so leaving them out can be intentional.")
        out.append("")
    if counts["differs"]:
        out.append(f"Differs from the reference ({counts['differs']}):")
        for r in by("differs"):
            out.append(f"  {r['path']}")
        out.append("  A difference can be a deliberate customization or an older copy. No record of")
        out.append("  the copied template version exists, so this check cannot tell which.")
        out.append("")
    if counts["skipped"]:
        out.append(f"Skipped, not compared ({counts['skipped']}):")
        for r in by("skipped"):
            out.append(f"  {r['path']}  ({REASONS[r['reason']]})")
        out.append("")
    if verbose and counts["identical"]:
        out.append(f"Identical ({counts['identical']}):")
        out.extend(f"  {r['path']}" for r in by("identical"))
        out.append("")
    elif counts["identical"]:
        out.append(f"Identical: {counts['identical']} (use --verbose to list them)")
        out.append("")

    if counts["skipped"]:
        out.append(f"Comparison incomplete: {counts['skipped']} file(s) could not be compared.")
    elif counts["missing"] or counts["differs"]:
        out.append(f"Comparison complete: {counts['missing']} missing, {counts['differs']} differ.")
    else:
        out.append("Comparison complete: every reference file is present with the same content.")
    out.append("Nothing was written; this command does not modify the project.")
    return "\n".join(out)


def render_json(project_dir, ref_dir, results):
    counts = _counts(results)
    return json.dumps({
        "project_dir": project_dir,
        "reference_dir": ref_dir,
        "complete": counts["skipped"] == 0,
        "counts": counts,
        "files": results,
    }, indent=2)


def main(argv=None):
    p = argparse.ArgumentParser(
        description="Read-only comparison of the project's .claude/memory/ against the template "
                    "reference bundled with the agent-harness plugin.")
    p.add_argument("--project-dir", dest="project_dir", required=True,
                   help="Absolute path of the project root to inspect. Required: it is never "
                        "guessed from the working directory, which may be a plugin cache.")
    p.add_argument("--reference", help="Reference directory (default: the bundled "
                                       f"{REFERENCE_DIRNAME}/ next to this script)")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--verbose", action="store_true", help="Also list identical files")
    args = p.parse_args(argv)

    if not os.path.isabs(args.project_dir):
        p.error(f"--project-dir must be an absolute path: {args.project_dir!r}")
    project_dir = os.path.normpath(args.project_dir)
    if not os.path.isdir(project_dir):
        print(f"error: project directory not found or not a directory: {project_dir}",
              file=sys.stderr)
        return 1
    ref_dir = os.path.abspath(args.reference) if args.reference else default_reference()

    try:
        results = compare(project_dir, ref_dir)
    except ReferenceInvalid as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    print(render_json(project_dir, ref_dir, results) if args.json
          else render_text(project_dir, ref_dir, results, args.verbose))
    return 0


if __name__ == "__main__":
    sys.exit(main())
