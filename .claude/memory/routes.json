{
  "//": "memory-search hook data (agent-harness dogfooding itself). Edited file or shell command → memory to inject.",
  "//command": "command_contains only looks at the raw shell command. For rules that need to be recalled when you run a command rather than when you edit a file.",
  "rules": [
    { "command_contains": ["gh pr create", "gh pr merge", "gh issue create"],
      "memory": ["review-evidence-on-target-thread.md"] },
    { "glob": "*/core/hooks/*", "memory": ["engine-data-separation.md", "hooks-live-dir-gotcha.md"] },
    { "contains": ["hook"], "memory": ["engine-data-separation.md", "hooks-live-dir-gotcha.md"] },
    { "contains": ["build.sh"], "memory": ["build-drift.md"] },
    { "glob": "*/core/*", "memory": ["build-drift.md"] },
    { "glob": "*SKILL.md", "memory": ["build-drift.md", "plugin-release-updates.md", "skill-command-examples.md"] },
    { "contains": ["codex/"], "memory": ["plugin-release-updates.md"] },
    { "contains": ["handoff.py", "scripts/"], "memory": ["adapter-cross-project-testing.md"] },
    { "contains": ["handoff.py", "reflect.py"], "memory": ["committed-artifact-env-leak.md"] },
    { "contains": ["repo_identity.py", ".cache", "cache_", "alias"], "memory": ["cache-must-outlive-target.md"] },
    { "glob": "*/tests/*", "memory": ["no-absolute-time-in-fixtures.md"] },
    { "glob": "*/docs/*", "memory": ["close-the-issue-close-the-doc.md"] },
    { "glob": "*README*.md", "memory": ["close-the-issue-close-the-doc.md"] },
    { "command_contains": ["gh issue close"], "memory": ["close-the-issue-close-the-doc.md"] }
  ]
}
